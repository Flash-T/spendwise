# SpendWise 后端配置
# 复制此文件为 .env 并填写配置

# 数据库
DATABASE_URL=sqlite:///./spendwise.db

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 应用
APP_NAME=SpendWise
DEBUG=true
